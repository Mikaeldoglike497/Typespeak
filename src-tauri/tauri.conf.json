{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypeSpeak",
  "version": "0.1.3",
  "identifier": "ai.typespeak.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TypeSpeak",
        "width": 1320,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "resizable": true,
        "transparent": false,
        "visible": false
      },
      {
        "label": "recording-overlay",
        "title": "TypeSpeak is listening",
        "url": "overlay.html",
        "width": 118,
        "height": 42,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "focus": false,
        "focusable": false,
        "transparent": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "NABILNET.AI",
    "copyright": "Copyright © 2026 NABILNET.AI",
    "category": "Productivity",
    "shortDescription": "Private local voice typing for Arabic, Lebanese, English, and mixed speech.",
    "longDescription": "TypeSpeak, developed by NABILNET.AI, is a Lebanese-first Windows dictation app with local speech models, per-language routing, translation, global hold-to-talk shortcuts, and private on-device transcript history.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../runtime/": "runtime/",
      "../runtime-cuda/": "runtime-cuda/"
    },
    "windows": {
      "wix": {
        "language": "en-US",
        "upgradeCode": "5f02d5cc-5d4c-4e56-9a4a-e2679fd7db31"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "./windows/installer-template.nsi",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "compression": "lzma",
        "startMenuFolder": "TypeSpeak",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
